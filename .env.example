DJANGO_SECRET_KEY=django-insecure-xv#im*-mx#_54(3^tf=_y683n$_9xj$5_xe4g#e0y0om0prg)h
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=V+ STEAM LAB Library
# Set the canonical domain for SEO (update for production)
SITE_URL=https://vplussteamlab.vn

DB_NAME=web3d
DB_USER=postgres
DB_PASSWORD=abc
DB_HOST=localhost
DB_PORT=5432

CONTRIBUTION_APPROVAL_POINTS=10
MAX_CONTRIBUTION_UPLOAD_MB=50
MAX_PREVIEW_UPLOAD_MB=5
MAX_PDF_PREVIEW_MB=20

# LXF (LEGO Digital Designer) conversion
# - auto: use CLI if configured, else fall back to built-in converter
# - cli: require external converter (lxf2ldr/ldd2ldraw)
# - python: force built-in converter
#LXF_CONVERTER_MODE=auto
# If empty and mode=auto, the app will try to find `lxf2ldr` / `ldd2ldraw` in PATH.
# Recommended (Windows): put the converter in PATH and set:
LXF_CONVERTER_MODE=cli
LXF_CONVERTER_CMD=lxf2ldr
#
# Command template (placeholders are optional):
#   LXF_CONVERTER_CMD=lxf2ldr
#   LXF_CONVERTER_CMD=lxf2ldr "{input}" "{output}"
# On Windows, prefer forward slashes (python-dotenv may unescape backslashes inside quotes):
#   LXF_CONVERTER_CMD=C:/tools/lxf2ldr.exe
#   LXF_CONVERTER_CMD="C:/Program Files/lxf2ldr/lxf2ldr.exe"
LXF_CONVERTER_CMD=
LXF_CONVERTER_TIMEOUT=30

# Signed media URLs
MEDIA_SIGNED_URLS=1
MEDIA_SIGNED_URL_TTL=300
MEDIA_SIGNED_URL_HIDE_PATH=1
MEDIA_SIGNED_URL_OG_TTL=86400
MEDIA_ACCEL_REDIRECT_PREFIX=
USE_SIGNED_DOWNLOADS=1

# Optional: self-host three.js assets for 3D viewer
LEGO_THREE_BASE_URL=https://cdn.jsdelivr.net/npm/three@0.160.0

# ZaloPay payment (VND)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT_CREATE=https://sb-openapi.zalopay.vn/v2/create
# Public callback URL that ZaloPay can reach
ZALOPAY_CALLBACK_URL=
# Customer return URL after payment
ZALOPAY_RETURN_URL=
# Optional: separate callback/return for points top-up
ZALOPAY_TOPUP_CALLBACK_URL=
ZALOPAY_TOPUP_RETURN_URL=

# Built-in .lxf -> .ldr tuning
# LDD transforms are in centimeters; LDraw uses LDU (1cm = 25 LDU)
LXF_LDRAW_SCALE=25
LXF_LDRAW_AXIS_CONVERT=1

ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_DETAIL=
