DJANGO_SECRET_KEY=django-insecure-xv#im*-mx#_54(3^tf=_y683n$_9xj$5_xe4g#e0y0om0prg)h
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=V+ STEAM LAB Library
# Set the canonical domain for SEO (update for production)
SITE_URL=http://127.0.0.1:8001
SECURE_SSL_REDIRECT=0

DB_NAME=web3d
DB_USER=postgres
DB_PASSWORD=abc
DB_HOST=localhost
DB_PORT=5432

CONTRIBUTION_APPROVAL_POINTS=10
MAX_CONTRIBUTION_UPLOAD_MB=50
MAX_PREVIEW_UPLOAD_MB=5
MAX_PDF_PREVIEW_MB=20

# LXF (LEGO Digital Designer) conversion
# - auto: use CLI if configured, else fall back to built-in converter
# - cli: require external converter (lxf2ldr/ldd2ldraw)
# - python: force built-in converter
#LXF_CONVERTER_MODE=auto
# If empty and mode=auto, the app will try to find `lxf2ldr` / `ldd2ldraw` in PATH.
# Recommended (Windows): put the converter in PATH and set:
LXF_CONVERTER_MODE=cli
LXF_CONVERTER_CMD=lxf2ldr
#
# Command template (placeholders are optional):
#   LXF_CONVERTER_CMD=lxf2ldr
#   LXF_CONVERTER_CMD=lxf2ldr "{input}" "{output}"
# On Windows, prefer forward slashes (python-dotenv may unescape backslashes inside quotes):
#   LXF_CONVERTER_CMD=C:/tools/lxf2ldr.exe
#   LXF_CONVERTER_CMD="C:/Program Files/lxf2ldr/lxf2ldr.exe"
LXF_CONVERTER_CMD=
LXF_CONVERTER_TIMEOUT=30

# Signed media URLs
MEDIA_SIGNED_URLS=1
MEDIA_SIGNED_URL_TTL=300
MEDIA_SIGNED_URL_HIDE_PATH=1
MEDIA_SIGNED_URL_OG_TTL=86400
MEDIA_ACCEL_REDIRECT_PREFIX=
USE_SIGNED_DOWNLOADS=1

# Performance tuning (optional)
# Keep LIBRARY_GRID_CACHE_TTL <= MEDIA_SIGNED_URL_TTL to avoid expired signed preview URLs.
LIBRARY_GRID_CACHE_TTL=60
CONTENT_VIEW_LOG_TTL=900
USE_REDIS_CACHE=0
#DJANGO_CACHE_URL=redis://localhost:6379/1
USE_FULLTEXT_SEARCH=1
POSTGRES_FTS_CONFIG=simple

# Optional: self-host three.js assets for 3D viewer
LEGO_THREE_BASE_URL=https://cdn.jsdelivr.net/npm/three@0.160.0

# YouTube Data API v3 key (optional, for playlist import in admin)
YOUTUBE_API_KEY=AIzaSyBjn0kKjH3dxZ7kMBQLAMdsHe9lnMcWhp4
# Blog publish API key (optional). Required for POST /blog/api/posts/
BLOG_POST_API_KEY=

# ZaloPay payment (VND)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT_CREATE=https://sb-openapi.zalopay.vn/v2/create
# Public callback URL that ZaloPay can reach
ZALOPAY_CALLBACK_URL=
# Customer return URL after payment
ZALOPAY_RETURN_URL=
# Optional: separate callback/return for points top-up
ZALOPAY_TOPUP_CALLBACK_URL=
ZALOPAY_TOPUP_RETURN_URL=

# Built-in .lxf -> .ldr tuning
# LDD transforms are in centimeters; LDraw uses LDU (1cm = 25 LDU)
LXF_LDRAW_SCALE=25
LXF_LDRAW_AXIS_CONVERT=1

ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_DETAIL=

# Blockly quiz (optional)
# Default: Google Blockly CDN. If you prefer RaspberryPiFoundation/blockly, host its build and set this URL.
BLOCKLY_QUIZ_BLOCKLY_JS_URL=https://unpkg.com/blockly/blockly.min.js
# Advanced: load multiple JS files in order (comma-separated).
# Example (classic build split files):
# BLOCKLY_QUIZ_BLOCKLY_JS_URLS=https://unpkg.com/blockly/blockly_compressed.js,https://unpkg.com/blockly/blocks_compressed.js,https://unpkg.com/blockly/msg/en.js
# Note: to render `blockly_state` (workspace JSON), prefer a modern build that includes `Blockly.serialization`
# (e.g. `https://unpkg.com/blockly/blockly.min.js`).
BLOCKLY_QUIZ_BLOCKLY_JS_URLS=
# Optional: Blockly media folder (icons, sounds). Useful when using compressed builds.
BLOCKLY_QUIZ_BLOCKLY_MEDIA_URL=https://unpkg.com/blockly/media/

# Optional: Scratch blocks renderer (scratchblocks). Used to render Scratch-style blocks from text.
BLOCKLY_QUIZ_SCRATCHBLOCKS_JS_URL=https://scratchblocks.github.io/js/scratchblocks-v3.6.1-min.js

# Optional: send quiz results to Google Sheets via an Apps Script Web App endpoint.
# Example: https://script.google.com/macros/s/XXXXX/exec
BLOCKLY_QUIZ_GSHEET_URL=
BLOCKLY_QUIZ_GSHEET_TIMEOUT=10
